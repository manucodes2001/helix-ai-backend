# Helix AI Environment Configuration
# Copy this file to .env and fill in your credentials. Never commit .env to version control.

# Required for AI-Powered Scientific Information Extraction (Engine 3)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Recommended for NCBI E-utilities (PubMed & GEO)
# Without an API key, NCBI limits requests to 3/second. With an API key, limit increases to 10/second.
NCBI_API_KEY=your_ncbi_api_key_here
NCBI_EMAIL=your_email@example.com

# Application Settings
HELIX_DB_PATH=data/helix_ai.db
LOG_LEVEL=INFO
